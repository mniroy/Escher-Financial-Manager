# Gemini API Key (Required for /api/process-receipt)
API_KEY=your_gemini_api_key_here

# Internal API Key for client-to-server auth (Required for /api/process-receipt)
RECEIPT_API_KEY=your_internal_secret_key_here

# Web Push Private Key (Required for /api/send-notification)
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Google API Key for Frontend (Optional, if needed by index.tsx)
VITE_API_KEY=your_gemini_api_key_here

# For Permanent Login (Authorization Code Flow)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# For WhatsApp Integration (Optional if not in webhook URL)
WAHA_API_KEY=your_waha_api_key_here

# For Web Push Notifications
VAPID_PUBLIC_KEY=your_vapid_public_key_here
